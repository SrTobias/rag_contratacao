# Copiar para .env e ajustar.

# --- LLM -------------------------------------------------------------------
# openai_compatible: Ollama, vLLM, LM Studio ou outro servidor com API compatível OpenAI
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
# Desenvolvimento: qwen2.5:7b | Produção (servidor com GPU): qwen2.5:32b, mistral-small, llama3.3:70b
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# Alternativa: Azure OpenAI (região UE, sem retenção de dados)
# LLM_PROVIDER=azure_openai
# LLM_BASE_URL=https://<recurso>.openai.azure.com
# LLM_API_KEY=...
# LLM_MODEL=<nome do deployment>
# AZURE_API_VERSION=2024-10-21

# --- Embeddings (sempre locais por omissão) --------------------------------
EMBED_PROVIDER=ollama
EMBED_MODEL=bge-m3
EMBED_BASE_URL=http://localhost:11434

# --- Pesquisa ----------------------------------------------------------------
TOP_K_LEGISLACAO=6
TOP_K_EXEMPLOS=4
MAX_CONTEXT_CHARS=24000

# --- Acesso ------------------------------------------------------------------
# Palavra-passe de acesso à aplicação (vazio = sem palavra-passe; NÃO usar em produção)
APP_PASSWORD=
