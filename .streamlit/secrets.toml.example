# Secrets para o Streamlit Community Cloud (só testes com documentos públicos).
# Copiar este conteúdo para: App settings → Secrets. Nunca enviar o secrets.toml real para o GitHub.

LLM_PROVIDER = "openai_compatible"
LLM_BASE_URL = "https://api.mistral.ai/v1"
LLM_API_KEY = "<chave Mistral>"
LLM_MODEL = "mistral-large-latest"
LLM_MAX_TOKENS = "2048"

EMBED_PROVIDER = "openai_compatible"
EMBED_BASE_URL = "https://api.mistral.ai/v1"
EMBED_API_KEY = "<chave Mistral>"
EMBED_MODEL = "mistral-embed"
EMBED_BATCH_SIZE = "16"

APP_PASSWORD = "<palavra-passe>"
